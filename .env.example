# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_admin_id_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/customs_bot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Kaspi API
KASPI_API_KEY=your_kaspi_api_key_here
KASPI_MERCHANT_ID=your_merchant_id_here
KASPI_SECRET_KEY=your_secret_key_here

# Stripe (backup)
STRIPE_API_KEY=your_stripe_api_key_here
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here

# Application
DEBUG=False
LOG_LEVEL=INFO
TIMEZONE=Asia/Almaty

# Currency rates
CURRENCY_SOURCE=./data/currency_rates.json
CURRENCY_UPDATE_INTERVAL=3600  # 1 hour

# Business rules
FREE_CALCULATIONS_PER_MONTH=3
PAY_PER_USE_PRICE=299
PACKAGE_1_PRICE=500
PACKAGE_1_CALCULATIONS=2
PACKAGE_2_PRICE=1000
PACKAGE_2_CALCULATIONS=5
PACKAGE_3_PRICE=2000
PACKAGE_3_CALCULATIONS=12
SUBSCRIPTION_PRICE=1990
